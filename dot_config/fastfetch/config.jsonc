{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    // "display",
    {
      "type": "display",
      "key": "Display",
      "format": "{1}x{2} @ {3}Hz"
    },
    "de",
    "wm",
    "wmtheme",
    // "theme",
    // "icons",
    // "font",
    // "cursor",
    "terminal",
    // "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    // "disk",
    {
      "type": "disk",
      "key": "Disk (Total)",
      "format": "{1} / {2} ({3})"
    },
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
